# Secrets for Kamal, read from the environment of the machine you deploy from.
# Never put raw credentials in this file; it's committed to the repository.

RAILS_MASTER_KEY=$(cat config/master.key)

# Generate once with `bin/rails runner 'k = WebPush.generate_key; puts k.public_key, k.private_key'`
# and keep them in your password manager. Changing them breaks every device's subscription.
VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
